function AddHud() {
    window.lograge = window.lograge || {};
    
    function formatNumberWithDots(x) {
        return x.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ".");
    }
(function () {
    if (!document.getElementById('notification-styles')) {
        const style = document.createElement('style');
        style.id = 'notification-styles';
style.textContent = `
#notifications-container {
    z-index: 9999;
    -webkit-user-select: none;
    user-select: none;
    display: flex;
    flex-direction: column-reverse;
    align-items: flex-end;
    width: 100vw;
    height: 100vh;
    padding: 4vh;
    position: fixed;
    bottom: 0;
    right: 0;
    pointer-events: none;
    background: linear-gradient(
        323deg,
        #1f1f1f 0.19%,
        #26262600 57.93%
    );

    animation: 0.25s forwards fade-in;
}

.notification-item {
    box-sizing: border-box;
    background: #ffffff4d;
    border-radius: 1vh;
    display: flex;
    align-items: center;
    min-width: 21vh;
    margin-top: 3vh;
    padding: 1.3vh;
    animation:
        0.25s fade-in,
        0.3s slide-in,
        0.25s 2.5s forwards fade-out;
}

.notification-icon {
    width: 3.7vh;
    height: 3.7vh;
    margin-right: 1.3vh;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
}

.notification-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
}

.notification-title {
    color: #fff;
    font-family: Open Sans, GothamPro, sans-serif;
    font-size: 1.50085vh;
    font-style: normal;
    font-weight: 600;
    line-height: 2.13447vh;
}

.notification-text {
    color: #ffffffb3;
    font-family: Open Sans, GothamPro, sans-serif;
    font-size: 1.2vh;
    font-style: normal;
    font-weight: 400;
}
.notification-item.hide {
    opacity: 0;
    transform: translateX(60px);
}

.notification-icon {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 2px solid rgba(255,255,255,0.9);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 14px;
    flex-shrink: 0;
    margin-right: 16px;
}

@keyframes fade-in {
    0% {
        opacity: 0;
    }
}

@keyframes fade-out {
    to {
        opacity: 0;
    }
}

@keyframes slide-in {
    0% {
        transform: translateY(1vh);
    }
}
`;
        document.head.appendChild(style);
    }

    const shadow = document.createElement('div');
    shadow.id = 'screen-shadow';
    document.body.appendChild(shadow);

    const container = document.createElement('div');
    container.id = 'notifications-container';
    document.body.appendChild(container);

    function createNotification(title, text, icon = 'i', duration = 3000) {
    container.style.display = 'flex';

    const notif = document.createElement('div');
    notif.className = 'notification-item';

    notif.innerHTML = `
        <div class="notification-icon">${icon}</div>
        <div class="notification-content">
            <div class="notification-title">${title}</div>
            <div class="notification-text">${text}</div>
        </div>
    `;

    container.appendChild(notif);

    setTimeout(() => {
        notif.remove();

        if (container.children.length === 0) {
            container.style.display = 'none';
        }
    }, duration);
}

    createNotification('Смена Радаров /radar', 'Загружена');
    createNotification('gameplay oss', 'Загружен');

})();

